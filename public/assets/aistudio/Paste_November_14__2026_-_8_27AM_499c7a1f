                        </td>
                        <td className="p-3.5 text-slate-600">{b.category || 'عام'}</td>
                        <td className="p-3.5 text-slate-600 font-mono">{b.source_page}</td>
                        <td className="p-3.5 text-center space-x-1.5 rtl:space-x-reverse">
                          <button
                            onClick={() => onEditBook(b)}
                            className="bg-blue-50 text-blue-700 hover:bg-blue-100 p-1.5 rounded-md transition"
                            title={t('editTooltip')}
                          >
                            <i className="fa-solid fa-pen-to-square"></i>
                          </button>
                          <button
                            onClick={() => onDeleteBook(b.id)}
                            className="bg-red-50 text-red-700 hover:bg-red-100 p-1.5 rounded-md transition"
                            title={t('deleteTooltip')}
                          >
                            <i className="fa-solid fa-trash-can"></i>
                          </button>
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            </div>

            {/* Pagination */}
            {totalPages > 1 && (
              <div className="p-4 border-t border-slate-200 flex items-center justify-between text-xs bg-slate-50">
                <button
                  onClick={() => setCurrentPage(p => Math.max(p - 1, 1))}
                  disabled={currentPage === 1}
                  className="px-3.5 py-1.5 rounded bg-white border border-slate-300 text-slate-700 disabled:opacity-40 font-bold"
                >
                  {t('prevPage')}
                </button>
                <span className="text-slate-600">
                  {t('pageLabel')} <strong>{currentPage}</strong> {t('outOfLabel')} <strong>{totalPages}</strong>
                </span>
                <button
                  onClick={() => setCurrentPage(p => Math.min(p + 1, totalPages))}
                  disabled={currentPage === totalPages}
                  className="px-3.5 py-1.5 rounded bg-white border border-slate-300 text-slate-700 disabled:opacity-40 font-bold"
                >
                  {t('nextPage')}
                </button>
              </div>
            )}

          </div>

        </div>
      );
    }

