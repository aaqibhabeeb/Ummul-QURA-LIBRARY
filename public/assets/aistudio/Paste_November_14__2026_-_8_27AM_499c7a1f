              <div>
                <p className="text-xs text-slate-500 font-bold">{t('metricSectionsCount')}</p>
                <h4 className="text-2xl font-bold text-slate-900 mt-1">
                  {new Set(books.map(b => b.alphabetical_section)).size}
                </h4>
              </div>
              <div className="w-12 h-12 rounded-xl bg-purple-100 text-purple-800 flex items-center justify-center text-xl">
