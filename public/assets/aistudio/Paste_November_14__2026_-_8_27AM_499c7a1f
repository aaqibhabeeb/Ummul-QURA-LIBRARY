    // Main App Component
    function App() {
      const [books, setBooks] = useState([]);
      const [activeTab, setActiveTab] = useState('catalog'); // 'catalog' | 'admin'
      const [lang, setLang] = useState('ur'); // 'ur' | 'en'
      const [toast, setToast] = useState(null);
      const [isAdminLoggedIn, setIsAdminLoggedIn] = useState(false);
      const [showLoginModal, setShowLoginModal] = useState(false);
      const [showImportModal, setShowImportModal] = useState(false);
      const [showAddModal, setShowAddModal] = useState(false);
      const [editingBook, setEditingBook] = useState(null);
      const [selectedDetailBook, setSelectedDetailBook] = useState(null);
      const [confirmDeleteId, setConfirmDeleteId] = useState(null);

      // Initialize App State & Persistent Storage
      useEffect(() => {
        // Load Language Preference
        const savedLang = localStorage.getItem('uql_app_lang');
        if (savedLang === 'en' || savedLang === 'ur') {
          setLang(savedLang);
        } else {
          setLang('ur');
        }

        // Load Catalog Books
        try {
          const stored = localStorage.getItem('uql_books_db');
          if (stored) {
            const parsed = JSON.parse(stored);
            if (Array.isArray(parsed) && parsed.length > 0) {
              setBooks(parsed);
              return;
            }
          }
        } catch (e) {
          console.error('LocalStorage read error:', e);
        }

        // Default setup if no localStorage
        setBooks(INITIAL_50_BOOKS);
        localStorage.setItem('uql_books_db', JSON.stringify(INITIAL_50_BOOKS));
      }, []);

      // Toggle Language Handler
      const toggleLanguage = () => {
        const nextLang = lang === 'ur' ? 'en' : 'ur';
        setLang(nextLang);
        localStorage.setItem('uql_app_lang', nextLang);
      };

      // Set HTML dir and lang attributes dynamically
      useEffect(() => {
        document.documentElement.lang = lang;
        document.documentElement.dir = lang === 'ur' ? 'rtl' : 'ltr';
      }, [lang]);

      const t = (key) => UI_DICTIONARY[lang][key] || key;

      // Handle Tab Switch (Guard Admin View)
      const handleTabSwitch = (tab) => {
        if (tab === 'admin' && !isAdminLoggedIn) {
          setShowLoginModal(true);
        } else {
          setActiveTab(tab);
        }
      };

      // Update State & LocalStorage Helper
      const updateBooksStateAndStorage = (newList) => {
        setBooks(newList);
        localStorage.setItem('uql_books_db', JSON.stringify(newList));
      };

      // Toast Notification Helper
      const showToast = (message, type = 'success') => {
        setToast({ message, type });
        setTimeout(() => setToast(null), 4000);
      };

      // Save or Edit Book
      const handleSaveBook = (bookData) => {
        if (editingBook) {
          const updated = books.map(b => b.id === editingBook.id ? { ...b, ...bookData } : b);
          updateBooksStateAndStorage(updated);
          showToast(t('toastUpdateSuccess'));
        } else {
          const newBook = {
            id: 'b_' + Date.now(),
            ...bookData
          };
          updateBooksStateAndStorage([newBook, ...books]);
          showToast(t('toastAddSuccess'));
        }
        setShowAddModal(false);
        setEditingBook(null);
      };

      // Delete Book
      const handleDeleteBook = (id) => {
        const updated = books.filter(b => b.id !== id);
        updateBooksStateAndStorage(updated);
        setConfirmDeleteId(null);
        showToast(t('toastDeleteSuccess'), 'warning');
      };

      // Reset Database
      const handleResetDatabase = () => {
        updateBooksStateAndStorage(INITIAL_50_BOOKS);
        showToast(t('toastResetSuccess'));
      };

      // Save Bulk Imported Records
      const handleBulkImportSave = (cleanRecords) => {
        const newEntries = cleanRecords.map((item, idx) => ({
          id: 'imp_' + Date.now() + '_' + idx,
          catalogue_number: item.catalogue_number || `UQL-IMP-${1000 + idx}`,
          title: item.title || 'غير عنوان شدہ',
          author: item.author || 'غير معروف مصنف',
          serial_number: item.serial_number || `SN-IMP-${100 + idx}`,
          alphabetical_section: item.alphabetical_section || 'أ',
          category: item.category || 'عام تالیف',
          source_page: item.source_page || 'ص ١',
          total_copies: parseInt(item.total_copies) || 5,
          available_copies: parseInt(item.available_copies) || 5
        }));

        const combined = [...newEntries, ...books];
        updateBooksStateAndStorage(combined);
        showToast(t('toastImportSuccess'), 'success');
      };

      return (
        <div className="min-h-screen flex flex-col bg-slate-50 text-slate-800">
          
          {/* HEADER */}
          <header className="bg-library-900 text-white shadow-xl border-b-2 border-gold-500 sticky top-0 z-30">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row items-center justify-between gap-4">
              
              {/* Logo & Correct Library Name */}
              <div className="flex items-center gap-3">
                <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-gold-400 to-gold-500 flex items-center justify-center text-library-950 font-bold text-2xl shadow-md border border-gold-300">
                  <i className="fa-solid fa-book-bookmark"></i>
                </div>
                <div>
                  <h1 className="text-2xl font-bold font-arabic-title text-gold-300 tracking-wide flex items-center gap-2">
                    {t('appTitle')}
                  </h1>
                  <p className="text-xs text-library-100">{t('appSubtitle')}</p>
                </div>
              </div>

              {/* Tabs & Controls */}
              <div className="flex items-center gap-3">
                <div className="flex items-center gap-2 bg-library-950 p-1.5 rounded-xl border border-library-800">
                  <button
                    onClick={() => handleTabSwitch('catalog')}
                    className={`px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-2 ${
                      activeTab === 'catalog'
                        ? 'bg-gold-500 text-library-950 shadow-md'
                        : 'text-library-100 hover:text-white hover:bg-library-800/60'
                    }`}
                  >
                    <i className="fa-solid fa-book-open"></i>
                    <span>{t('publicCatalogTab')}</span>
                  </button>

                  <button
                    onClick={() => handleTabSwitch('admin')}
                    className={`px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition flex items-center gap-2 ${
                      activeTab === 'admin'
                        ? 'bg-gold-500 text-library-950 shadow-md'
                        : 'text-library-100 hover:text-white hover:bg-library-800/60'
                    }`}
                  >
                    <i className="fa-solid fa-user-shield"></i>
                    <span>{t('adminDashboardTab')}</span>
                    <span className="bg-library-900 text-gold-300 text-xs px-2 py-0.5 rounded-full font-bold">
                      {books.length}
                    </span>
                  </button>
                </div>

                {/* Admin Logout Button */}
                {isAdminLoggedIn && (
                  <button
                    onClick={() => { setIsAdminLoggedIn(false); setActiveTab('catalog'); }}
                    className="bg-red-700 hover:bg-red-600 text-white font-bold px-3 py-2 rounded-xl text-xs shadow transition flex items-center gap-1.5"
                    title={t('adminLogout')}
                  >
                    <i className="fa-solid fa-right-from-bracket"></i>
                    <span className="hidden sm:inline">{t('adminLogout')}</span>
                  </button>
                )}

                {/* LANGUAGE SWITCHER BUTTON */}
                <button
                  onClick={toggleLanguage}
                  className="bg-gold-500 hover:bg-gold-400 text-library-950 font-bold px-3.5 py-2.5 rounded-xl text-xs sm:text-sm shadow-md transition flex items-center gap-2 border border-gold-300"
                  title="Toggle Language / زبان منتخب کریں"
                >
                  <i className="fa-solid fa-globe"></i>
                  <span>{lang === 'ur' ? '🌐 English' : '🌐 اردو'}</span>
                </button>
              </div>

            </div>
          </header>

          {/* MAIN CONTENT VIEW */}
          <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
            {activeTab === 'catalog' ? (
              <PublicCatalog
                books={books}
                onSelectDetail={(b) => setSelectedDetailBook(b)}
                t={t}
              />
            ) : (
              <AdminDashboard
                books={books}
                onOpenImport={() => setShowImportModal(true)}
                onOpenAdd={() => { setEditingBook(null); setShowAddModal(true); }}
                onEditBook={(b) => { setEditingBook(b); setShowAddModal(true); }}
                onDeleteBook={(id) => setConfirmDeleteId(id)}
                onResetDatabase={handleResetDatabase}
                t={t}
              />
            )}
          </main>

          {/* FOOTER */}
          <footer className="bg-slate-900 text-slate-400 text-xs py-5 border-t border-slate-800 text-center mt-auto">
            <div className="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-2">
              <p>{t('footerCopyright')}</p>
              <p className="text-slate-500">{t('footerFeature')}</p>
            </div>
          </footer>

          {/* TOAST NOTIFICATION */}
          {toast && (
            <div className={`fixed bottom-5 ${lang === 'ur' ? 'left-5' : 'right-5'} z-50 animate-bounce`}>
              <div className={`px-5 py-3 rounded-xl shadow-2xl text-white font-bold text-sm flex items-center gap-3 border ${
                toast.type === 'warning' ? 'bg-amber-600 border-amber-400' : 'bg-library-800 border-library-600'
              }`}>
                <i className={`fa-solid ${toast.type === 'warning' ? 'fa-triangle-exclamation' : 'fa-circle-check'} text-lg`}></i>
                <span>{toast.message}</span>
              </div>
            </div>
          )}

          {/* ADMIN LOGIN MODAL */}
          {showLoginModal && (
            <AdminLoginModal
              onSuccess={() => {
                setIsAdminLoggedIn(true);
                setShowLoginModal(false);
                setActiveTab('admin');
              }}
              onClose={() => setShowLoginModal(false)}
              t={t}
            />
          )}

          {/* BULK IMPORT MODAL */}
          {showImportModal && (
            <BulkBookImporter
              existingBooks={books}
              onSaveImportedBooks={handleBulkImportSave}
              onClose={() => setShowImportModal(false)}
