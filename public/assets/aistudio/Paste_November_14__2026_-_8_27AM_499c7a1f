    function BulkBookImporter({ existingBooks, onSaveImportedBooks, onClose, t, lang }) {
      const [parsedRows, setParsedRows] = useState([]);
      const [fileName, setFileName] = useState('');
      const [filterMode, setFilterMode] = useState('ALL'); // 'ALL' | 'VALID' | 'ERRORS'
      const [importSummary, setImportSummary] = useState(null);
      const [isDragging, setIsDragging] = useState(false);

      const existingCatNumbers = useMemo(() => {
        return new Set(existingBooks.map(b => String(b.catalogue_number || '').trim().toLowerCase()));
      }, [existingBooks]);

      const mapRawRowToBookSchema = (rawRow) => {
        const rowKeys = Object.keys(rawRow);
        const mapped = {};

        Object.keys(HEADER_MAP).forEach(standardKey => {
          const matchedKey = rowKeys.find(rk => 
            HEADER_MAP[standardKey].includes(String(rk).trim().toLowerCase())
          );
          mapped[standardKey] = matchedKey ? String(rawRow[matchedKey]).trim() : '';
        });

        return mapped;
      };

      const validateItem = (item, index, allItems) => {
        const catNum = String(item.catalogue_number || '').trim();
        const title = String(item.title || '').trim();

        let isDuplicateDB = false;
        let isDuplicateFile = false;
        let warning = '';

        if (!title) {
          warning = t('errMissingTitle');
        } else if (!catNum) {
          warning = t('errMissingCat');
        } else if (existingCatNumbers.has(catNum.toLowerCase())) {
          isDuplicateDB = true;
          warning = t('errDupDb');
        } else {
          const firstIdx = allItems.findIndex(x => String(x.catalogue_number || '').trim().toLowerCase() === catNum.toLowerCase());
          if (firstIdx !== -1 && firstIdx < index) {
            isDuplicateFile = true;
            warning = t('errDupFile');
          }
        }

        const isValid = Boolean(title && catNum && !isDuplicateDB && !isDuplicateFile);

        return {
          ...item,
          isValid,
          isDuplicateDB,
          isDuplicateFile,
          warningMessage: warning
        };
      };

      const processFile = (file) => {
        if (!file) return;
        setFileName(file.name);

        const reader = new FileReader();
        reader.onload = (e) => {
          try {
            const data = new Uint8Array(e.target.result);
            const workbook = window.XLSX.read(data, { type: 'array' });
            const sheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[sheetName];
            const rawRows = window.XLSX.utils.sheet_to_json(worksheet, { defval: '' });

            if (!rawRows || rawRows.length === 0) {
              alert(lang === 'ur' ? 'منتخب فائل میں معلومات نہیں ہیں۔' : 'The selected file is empty.');
              return;
            }

            const rawMapped = rawRows.map(mapRawRowToBookSchema);

            const validated = rawMapped.map((item, idx, array) => ({
              tempId: `row_${Date.now()}_${idx}`,
              ...validateItem(item, idx, array)
            }));

            setParsedRows(validated);
            setImportSummary(null);
          } catch (err) {
            console.error('File parsing error:', err);
            alert(lang === 'ur' ? 'فائل پڑھنے میں خطا پیش آئی ہے۔' : 'Error parsing file.');
          }
        };

        reader.readAsArrayBuffer(file);
      };

      const handleCellEdit = (index, field, newValue) => {
        const copy = [...parsedRows];
        copy[index][field] = newValue;

        const revalidated = copy.map((item, idx, arr) => validateItem(item, idx, arr));
        setParsedRows(revalidated);
      };

      const handleRemoveRow = (index) => {
        const copy = parsedRows.filter((_, i) => i !== index);
        const revalidated = copy.map((item, idx, arr) => validateItem(item, idx, arr));
        setParsedRows(revalidated);
      };

      const handleExecuteImport = () => {
        const validRecords = parsedRows.filter(r => r.isValid);
        const failedCount = parsedRows.length - validRecords.length;

        if (validRecords.length === 0) {
          alert(lang === 'ur' ? 'درآمد کے لیے کوئی درست کتاب موجود نہیں ہے۔' : 'No valid records to import.');
          return;
        }

        const cleanToSave = validRecords.map(({ tempId, isValid, isDuplicateDB, isDuplicateFile, warningMessage, ...rest }) => rest);

        onSaveImportedBooks(cleanToSave);

        setImportSummary({
          successCount: validRecords.length,
          skippedCount: failedCount
        });
        setParsedRows([]);
      };

      const handleDownloadSample = () => {
        const sampleData = [
          {
            "Title": "سنن الدارمي",
            "Author": "الإمام عبد الله بن عبد الرحمن الدارمي",
            "Serial Number": "SN-2024-051",
            "Catalogue Number": "UQL-1051",
            "Alphabetical Section": "س",
            "Source Page": "ص ٥٠",
            "Category": "حدیث شریف",
            "Total Copies": 5,
            "Available Copies": 4
          },
          {
            "Title": "مشكاة المصابيح",
            "Author": "الخطيب التبريزي",
            "Serial Number": "SN-2024-052",
            "Catalogue Number": "UQL-1052",
            "Alphabetical Section": "م",
            "Source Page": "ص ١٢٠",
            "Category": "حدیث شریف",
            "Total Copies": 6,
            "Available Copies": 5
          },
          {
            "Title": "عقیدہ طحاویہ (اردو شرح)",
            "Author": "مولانا عبدالرحمن صاحب",
            "Serial Number": "SN-2024-053",
            "Catalogue Number": "UQL-1053",
            "Alphabetical Section": "ع",
            "Source Page": "ص ٨٥",
            "Category": "علم العقیدہ",
            "Total Copies": 4,
            "Available Copies": 3
          }
        ];

        const ws = window.XLSX.utils.json_to_sheet(sampleData);
        const wb = window.XLSX.utils.book_new();
        window.XLSX.utils.book_append_sheet(wb, ws, "SampleBooks");
        window.XLSX.writeFile(wb, "اُمّ القریٰ لائبریری - کتابوں کی فہرست.xlsx");
      };

      const visibleRows = useMemo(() => {
        if (filterMode === 'VALID') return parsedRows.filter(r => r.isValid);
        if (filterMode === 'ERRORS') return parsedRows.filter(r => !r.isValid);
        return parsedRows;
      }, [parsedRows, filterMode]);

      return (
        <div className="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-3 sm:p-6 overflow-y-auto">
          <div className="bg-white rounded-2xl w-full max-w-6xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[92vh]">
            
            {/* Header */}
            <div className="bg-gradient-to-r from-library-950 to-slate-900 text-white p-5 flex items-center justify-between border-b border-gold-500/30">
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 rounded-lg bg-library-700 flex items-center justify-center text-xl text-gold-300 shadow">
                  <i className="fa-solid fa-file-excel"></i>
                </div>
                <div>
                  <h3 className="text-lg font-bold text-gold-300">
                    {t('bulkModalTitle')}
                  </h3>
                  <p className="text-xs text-library-100">{t('bulkModalSubtitle')}</p>
                </div>
              </div>

              <button
                onClick={onClose}
                className="text-slate-400 hover:text-white p-2 text-lg transition"
              >
                <i className="fa-solid fa-xmark"></i>
              </button>
            </div>

            {/* Body */}
            <div className="p-6 overflow-y-auto space-y-6 flex-1">
              
              {/* Dropzone */}
              <div
                onDragOver={(e) => { e.preventDefault(); setIsDragging(true); }}
                onDragLeave={() => setIsDragging(false)}
                onDrop={(e) => {
                  e.preventDefault();
                  setIsDragging(false);
                  if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                    processFile(e.dataTransfer.files[0]);
                  }
                }}
                className={`border-2 border-dashed rounded-2xl p-6 text-center transition ${
                  isDragging ? 'border-gold-500 bg-gold-50/50' : 'border-slate-300 bg-slate-50 hover:bg-slate-100/70'
                }`}
              >
                <input
                  type="file"
                  accept=".csv, .xlsx, .xls"
                  onChange={(e) => processFile(e.target.files[0])}
                  id="bulk-file-input"
                  className="hidden"
                />

                <div className="space-y-3">
                  <div className="w-14 h-14 mx-auto rounded-full bg-library-100 text-library-900 flex items-center justify-center text-2xl shadow-inner">
                    <i className="fa-solid fa-cloud-arrow-up"></i>
                  </div>
                  <div>
                    <label
                      htmlFor="bulk-file-input"
                      className="cursor-pointer font-bold text-library-900 hover:text-library-950 underline text-sm"
                    >
                      {t('dropzoneClick')}
                    </label>
                    <span className="text-xs text-slate-500 me-1"> {t('dropzoneOr')}</span>
                  </div>
                  <p className="text-xs text-slate-500">{t('supportedFormats')}</p>

                  <div className="pt-2">
                    <button
                      onClick={handleDownloadSample}
                      type="button"
                      className="inline-flex items-center gap-1.5 text-xs text-gold-950 bg-gold-100 hover:bg-gold-300 px-3.5 py-2 rounded-lg font-bold transition border border-gold-300"
                    >
                      <i className="fa-solid fa-download"></i>
                      <span>{t('downloadSampleBtn')}</span>
                    </button>
                  </div>
                </div>

                {fileName && (
                  <div className="mt-4 inline-flex items-center gap-2 bg-library-50 text-library-900 text-xs px-4 py-1.5 rounded-full border border-library-300 font-bold">
                    <i className="fa-solid fa-file-csv"></i>
                    <span>{t('selectedFileLabel')} {fileName}</span>
                  </div>
                )}
              </div>

              {/* Summary Alert */}
              {importSummary && (
                <div className="bg-library-50 border border-library-300 rounded-xl p-5 text-library-950 space-y-2">
                  <div className="flex items-center gap-2 font-bold text-base">
                    <i className="fa-solid fa-circle-check text-library-800 text-xl"></i>
                    <span>{t('importCompletedTitle')}</span>
                  </div>
                  <div className="text-xs space-y-1 pr-7 font-bold">
                    <p>{t('savedCountLabel')} <strong>{importSummary.successCount}</strong></p>
                    {importSummary.skippedCount > 0 && (
                      <p className="text-amber-800">{t('skippedCountLabel')} <strong>{importSummary.skippedCount}</strong></p>
                    )}
                  </div>
                </div>
              )}

              {/* Preview Table */}
              {parsedRows.length > 0 && (
                <div className="space-y-4">
                  
                  {/* Controls */}
                  <div className="flex flex-col sm:flex-row items-center justify-between gap-3 bg-slate-100 p-3 rounded-xl border border-slate-200">
                    <div className="flex items-center gap-2 text-xs">
                      <button
                        onClick={() => setFilterMode('ALL')}
                        className={`px-3 py-1 rounded-lg transition font-bold ${
                          filterMode === 'ALL' ? 'bg-slate-800 text-white' : 'bg-white text-slate-700 hover:bg-slate-200'
                        }`}
                      >
                        {t('filterAllRows')} ({parsedRows.length})
                      </button>
                      <button
                        onClick={() => setFilterMode('VALID')}
                        className={`px-3 py-1 rounded-lg transition font-bold ${
                          filterMode === 'VALID' ? 'bg-library-800 text-white' : 'bg-white text-library-800 hover:bg-slate-200'
                        }`}
                      >
                        {t('filterValidRows')} ({parsedRows.filter(r => r.isValid).length})
                      </button>
                      <button
                        onClick={() => setFilterMode('ERRORS')}
                        className={`px-3 py-1 rounded-lg transition font-bold ${
                          filterMode === 'ERRORS' ? 'bg-red-700 text-white' : 'bg-white text-red-700 hover:bg-slate-200'
                        }`}
                      >
                        {t('filterErrorRows')} ({parsedRows.filter(r => !r.isValid).length})
                      </button>
                    </div>

                    <button
                      onClick={handleExecuteImport}
                      className="bg-library-800 hover:bg-library-900 text-white text-xs font-bold px-5 py-2.5 rounded-lg shadow transition flex items-center gap-2"
                    >
                      <i className="fa-solid fa-cloud-arrow-down"></i>
                      <span>{t('saveValidBtn')} ({parsedRows.filter(r => r.isValid).length})</span>
                    </button>
                  </div>

                  {/* Table */}
                  <div className="border border-slate-200 rounded-xl overflow-x-auto max-h-96">
                    <table className="w-full text-xs ltr:text-left rtl:text-right">
                      <thead className="bg-slate-800 text-white sticky top-0 z-10 font-bold">
                        <tr>
                          <th className="p-3">{t('colStatus')}</th>
                          <th className="p-3">{t('colTitle')}</th>
                          <th className="p-3">{t('colAuthor')}</th>
                          <th className="p-3">{t('colSerialNo')}</th>
                          <th className="p-3">{t('colCatNo')}</th>
                          <th className="p-3">{t('colSection')}</th>
                          <th className="p-3">{t('colSourcePage')}</th>
                          <th className="p-3 text-center">{t('colActions')}</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-200 bg-white">
                        {visibleRows.length === 0 ? (
                          <tr>
                            <td colSpan="8" className="p-6 text-center text-slate-400">
                              {t('noRowsInFilter')}
                            </td>
                          </tr>
                        ) : (
                          visibleRows.map((row) => {
                            const realIndex = parsedRows.findIndex(r => r.tempId === row.tempId);
                            return (
                              <tr
                                key={row.tempId}
                                className={
                                  row.isDuplicateDB || row.isDuplicateFile
                                    ? 'bg-red-50/80 hover:bg-red-100/60'
                                    : !row.isValid
                                    ? 'bg-amber-50/80 hover:bg-amber-100/60'
                                    : 'hover:bg-slate-50'
                                }
                              >
                                <td className="p-2 min-w-[170px]">
                                  {row.isValid ? (
                                    <span className="inline-flex items-center gap-1 bg-library-100 text-library-950 font-bold px-2 py-0.5 rounded text-[11px]">
                                      <i className="fa-solid fa-check"></i> {t('statusReady')}
                                    </span>
                                  ) : (
                                    <span className="inline-flex items-center gap-1 bg-red-100 text-red-900 font-bold px-2 py-0.5 rounded text-[11px]" title={row.warningMessage}>
                                      {row.warningMessage}
                                    </span>
                                  )}
                                </td>

                                <td className="p-1.5">
                                  <input
                                    type="text"
                                    value={row.title}
                                    onChange={(e) => handleCellEdit(realIndex, 'title', e.target.value)}
                                    className="w-full p-1.5 border border-slate-300 rounded text-xs font-bold font-arabic-title"
                                  />
                                </td>

                                <td className="p-1.5">
                                  <input
                                    type="text"
                                    value={row.author}
                                    onChange={(e) => handleCellEdit(realIndex, 'author', e.target.value)}
                                    className="w-full p-1.5 border border-slate-300 rounded text-xs"
                                  />
                                </td>

                                <td className="p-1.5">
                                  <input
                                    type="text"
                                    value={row.serial_number}
                                    onChange={(e) => handleCellEdit(realIndex, 'serial_number', e.target.value)}
                                    className="w-full p-1.5 border border-slate-300 rounded text-xs font-mono"
                                  />
                                </td>

                                <td className="p-1.5">
                                  <input
                                    type="text"
                                    value={row.catalogue_number}
                                    onChange={(e) => handleCellEdit(realIndex, 'catalogue_number', e.target.value)}
                                    className={`w-full p-1.5 border rounded text-xs font-mono font-bold ${
                                      row.isDuplicateDB || row.isDuplicateFile ? 'border-red-500 bg-red-50 text-red-900' : 'border-slate-300'
                                    }`}
                                  />
                                </td>

                                <td className="p-1.5 w-20">
                                  <input
                                    type="text"
                                    value={row.alphabetical_section}
                                    onChange={(e) => handleCellEdit(realIndex, 'alphabetical_section', e.target.value)}
                                    className="w-full p-1.5 border border-slate-300 rounded text-xs text-center font-bold"
                                  />
                                </td>

                                <td className="p-1.5 w-24">
                                  <input
                                    type="text"
                                    value={row.source_page}
                                    onChange={(e) => handleCellEdit(realIndex, 'source_page', e.target.value)}
                                    className="w-full p-1.5 border border-slate-300 rounded text-xs text-center"
                                  />
                                </td>

                                <td className="p-1.5 text-center">
                                  <button
                                    onClick={() => handleRemoveRow(realIndex)}
                                    className="text-red-600 hover:text-red-800 p-1 rounded"
                                    title={t('deleteTooltip')}
                                  >
                                    <i className="fa-solid fa-trash-can"></i>
                                  </button>
                                </td>
                              </tr>
                            );
                          })
                        )}
                      </tbody>
                    </table>
                  </div>

                </div>
              )}

            </div>

            {/* Footer */}
            <div className="bg-slate-100 p-4 border-t border-slate-200 flex justify-between items-center">
              <span className="text-xs text-slate-600">
                {t('bulkHelpFooter')}
              </span>
              <button
                onClick={onClose}
                className="bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold px-5 py-2 rounded-lg transition"
              >
                {t('closeBtn')}
              </button>
            </div>

          </div>
        </div>
      );
    }

    // =========================================================================
    // ADD / EDIT BOOK MODAL
    // =========================================================================
    function AddEditBookModal({ book, onSave, onClose, t }) {
      const [formData, setFormData] = useState({
        title: book ? book.title : '',
        author: book ? book.author : '',
        serial_number: book ? book.serial_number : 'SN-2024-' + Math.floor(100 + Math.random() * 900),
        catalogue_number: book ? book.catalogue_number : 'UQL-' + Math.floor(1051 + Math.random() * 500),
        alphabetical_section: book ? book.alphabetical_section : 'أ',
        source_page: book ? book.source_page : 'ص ١',
        category: book ? book.category : 'حدیث شریف',
        total_copies: book ? book.total_copies : 5,
        available_copies: book ? book.available_copies : 5
      });

      const handleSubmit = (e) => {
        e.preventDefault();
        if (!formData.title || !formData.catalogue_number) {
          alert('Title and Catalogue Number are required.');
          return;
        }
        onSave(formData);
      };

      return (
        <div className="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl p-6 max-w-lg w-full shadow-2xl border border-slate-200">
            <h3 className="text-lg font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 font-arabic-title">
              {book ? t('editTitle') : t('addTitle')}
            </h3>

            <form onSubmit={handleSubmit} className="space-y-4 text-xs">
              <div>
                <label className="block font-bold text-slate-700 mb-1">{t('fieldTitle')}</label>
                <input
                  type="text"
                  required
                  value={formData.title}
                  onChange={(e) => setFormData({ ...formData, title: e.target.value })}
                  className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm font-bold text-slate-900 font-arabic-title"
                />
              </div>

              <div>
                <label className="block font-bold text-slate-700 mb-1">{t('fieldAuthor')}</label>
                <input
                  type="text"
                  required
                  value={formData.author}
                  onChange={(e) => setFormData({ ...formData, author: e.target.value })}
                  className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-700 mb-1">{t('fieldCatNo')}</label>
                  <input
                    type="text"
                    required
                    value={formData.catalogue_number}
                    onChange={(e) => setFormData({ ...formData, catalogue_number: e.target.value })}
                    className="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg font-mono font-bold text-library-900"
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-700 mb-1">{t('fieldSerialNo')}</label>
                  <input
                    type="text"
                    value={formData.serial_number}
                    onChange={(e) => setFormData({ ...formData, serial_number: e.target.value })}
                    className="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg font-mono text-slate-600"
                  />
                </div>
              </div>

              <div className="grid grid-cols-3 gap-3">
                <div>
                  <label className="block font-bold text-slate-700 mb-1">{t('fieldSection')}</label>
                  <input
                    type="text"
                    value={formData.alphabetical_section}
                    onChange={(e) => setFormData({ ...formData, alphabetical_section: e.target.value })}
                    className="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-bold"
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-700 mb-1">{t('fieldSourcePage')}</label>
                  <input
                    type="text"
                    value={formData.source_page}
                    onChange={(e) => setFormData({ ...formData, source_page: e.target.value })}
                    className="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-center"
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-700 mb-1">{t('fieldCategory')}</label>
                  <input
                    type="text"
                    value={formData.category}
                    onChange={(e) => setFormData({ ...formData, category: e.target.value })}
                    className="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-700 mb-1">{t('fieldTotalCopies')}</label>
                  <input
                    type="number"
                    min="1"
                    value={formData.total_copies}
                    onChange={(e) => setFormData({ ...formData, total_copies: parseInt(e.target.value) || 1 })}
                    className="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-bold"
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-700 mb-1">{t('fieldAvailableCopies')}</label>
                  <input
                    type="number"
                    min="0"
                    value={formData.available_copies}
                    onChange={(e) => setFormData({ ...formData, available_copies: parseInt(e.target.value) || 0 })}
                    className="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-center font-bold"
                  />
                </div>
              </div>

              <div className="pt-4 flex justify-end gap-2 border-t border-slate-100">
                <button
                  type="button"
                  onClick={onClose}
                  className="px-4 py-2 bg-slate-200 text-slate-700 font-bold rounded-lg hover:bg-slate-300"
                >
                  {t('cancelBtn')}
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 bg-library-800 text-white font-bold rounded-lg hover:bg-library-900"
                >
                  {t('saveBtn')}
                </button>
              </div>
            </form>
          </div>
        </div>
      );
    }

    // =========================================================================
    // BOOK DETAIL MODAL
    // =========================================================================
    function BookDetailModal({ book, onClose, t }) {
      return (
        <div className="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl p-6 max-w-lg w-full shadow-2xl border border-slate-200 space-y-4">
            
            <div className="flex justify-between items-start border-b border-slate-100 pb-3">
              <span className="bg-library-100 text-library-950 font-mono font-bold text-xs px-3 py-1 rounded-md">
                {book.catalogue_number}
              </span>
              <button onClick={onClose} className="text-slate-400 hover:text-slate-700 text-lg">
                <i className="fa-solid fa-xmark"></i>
              </button>
            </div>

            <div className="space-y-3">
              <h2 className="text-2xl font-bold font-arabic-title text-slate-900 leading-snug">
                {book.title}
              </h2>
              <p className="text-sm text-slate-600">
                {t('authorPrefix')} <strong className="text-slate-900">{book.author}</strong>
              </p>

              <div className="bg-slate-50 p-4 rounded-xl border border-slate-200 grid grid-cols-2 gap-3 text-xs font-mono">
                <div>
                  <span className="text-slate-400 block font-sans">{t('serialPrefix')}</span>
                  <span className="font-bold text-slate-800">{book.serial_number}</span>
                </div>
                <div>
                  <span className="text-slate-400 block font-sans">{t('alphabeticalSectionLabel')}</span>
                  <span className="font-bold text-amber-700">{book.alphabetical_section}</span>
                </div>
                <div>
                  <span className="text-slate-400 block font-sans">{t('sourcePagePrefix')}</span>
                  <span className="font-bold text-slate-800">{book.source_page}</span>
                </div>
                <div>
                  <span className="text-slate-400 block font-sans">{t('subjectLabel')}</span>
                  <span className="font-bold text-slate-800 font-sans">{book.category || 'عام'}</span>
                </div>
                <div>
                  <span className="text-slate-400 block font-sans">{t('availableCopiesLabel')}</span>
                  <span className="font-bold text-library-800">{book.available_copies}</span>
                </div>
                <div>
                  <span className="text-slate-400 block font-sans">{t('totalCopiesLabel')}</span>
                  <span className="font-bold text-slate-800">{book.total_copies}</span>
                </div>
              </div>
            </div>

            <div className="pt-2 text-right rtl:text-left">
              <button
                onClick={onClose}
                className="bg-slate-800 text-white text-xs font-bold px-5 py-2 rounded-lg hover:bg-slate-900"
              >
                {t('closeBtn')}
              </button>
            </div>
          </div>
        </div>
      );
    }

    const rootElement = document.getElementById('root');
    const root = ReactDOM.createRoot(rootElement);
    root.render(<App />);
  </script>
</body>
</html>